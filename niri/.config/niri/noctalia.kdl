layout {

    focus-ring {
        active-color   "#a9cdd5"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#a9cdd5"
        inactive-color "#121414"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#a9cdd5"
        inactive-color "#2d4f56"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#a9cdd580"
    }
}

recent-windows {
    highlight {
        active-color "#a9cdd5"
        urgent-color "#ffb4ab"
    }
}
